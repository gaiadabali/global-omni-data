{
  "name": "@god/geo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Real Australian geography from the ABS (ASGS Edition 3): areas, parents, population, suburbs and point lookups. Pure functions over bundled JSON.",
  "exports": {
    ".": "./src/index.ts",
    "./topo": "./src/topo.ts",
    "./shape": "./src/shape.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "build:data": "node scripts/build-data.mjs"
  },
  "dependencies": {
    "h3-js": "4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "26.6.2",
    "eslint": "9.39.4",
    "fflate": "0.8.3",
    "shapefile": "0.6.6",
    "topojson-client": "3.1.0",
    "topojson-server": "3.0.1",
    "topojson-simplify": "3.0.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.0"
  }
}
