# GOD dashboard settings. Names only: never put a value in this file or anywhere in the repo.
# Secrets live on the server (Helios), outside the repo.

# --- Deployment and dev sign-in ---
# Dev sign-in is on only when BOTH are set: GOD_DEV_AUTH=1 and GOD_DEPLOYMENT=dev.
# GOD_DEV_AUTH=1 with any other GOD_DEPLOYMENT refuses to start. Staging and production set neither.
GOD_DEPLOYMENT=
GOD_DEV_AUTH=

# --- Sign in with YourTal (required whenever dev sign-in is off; the server refuses to start without them) ---
# The YourTal issuer, exactly as its discovery document names it (staging: https://yourtal.gaiada.com/oidc).
YOURTAL_ISSUER=
# The dashboard's client id at YourTal (god-dashboard).
GOD_OIDC_CLIENT_ID=
# SECRET. Path to a file holding the private RSA JWK (with a kid) for private_key_jwt. Mode 0400.
# Its public half goes to YourTal as god-dashboard.jwks.json.
GOD_OIDC_KEY_FILE=
# The dashboard's public https origin, no path (https://dashboard.god.gaiada.com). The redirect URI is
# <origin>/auth/callback, and sign-out checks the Origin header against it.
GOD_PUBLIC_URL=
# SECRET. 32 bytes or more of random data. Keys the encrypted sign-in cookie and the audit log's sub hashes.
# Changing it ends sign-ins in progress (not sessions).
GOD_SESSION_SECRET=

# --- Stores ---
# Postgres for the allow-list, sessions and audit log (wired at merge). Unset: in memory (dev, tests, screenshots).
GOD_DATABASE_URL=

# --- Data and maps ---
GOD_DATA_PROVIDER=
GOD_BASEMAP_PMTILES=

# --- Contact form (POST /api/public/contact, the only route that needs no sign-in) ---
# The one Origin the route accepts: the public site (https://god.gaiada.com). Unset: that default. Localhost is also
# accepted while GOD_DEPLOYMENT=dev.
GOD_SITE_ORIGIN=
# Email heads-up for each new enquiry. Enquiries are always stored first; if ANY of these three is unset, no email is
# sent (logged once) and nothing is lost. Helios's local postfix signs with DKIM.
# SMTP server, for example smtp://127.0.0.1:25 (no TLS to loopback; anywhere else STARTTLS is required).
GOD_SMTP_URL=
# Where the notification goes (hello@god.gaiada.com).
GOD_ENQUIRY_TO=
# The sender, as an address with a name: GOD website <no-reply@god.gaiada.com>
GOD_ENQUIRY_FROM=
