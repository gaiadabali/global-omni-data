---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";

interface Brand {
  id: string;
  n: number;
  name: string;
  lede: string;
  href: string;
  host: string;
  people: string[];
  businesses: string[];
}

const brands: Brand[] = [
  {
    id: "yourtal",
    n: 1,
    name: "YourTal",
    lede: "Watch a campaign, earn points, swap them for vouchers.",
    href: "https://yourtal.gaiada.com",
    host: "yourtal.gaiada.com",
    people: [
      "Watch short campaigns from brands you pick, and earn points for finishing them.",
      "Redeem points for vouchers at local businesses.",
      "Set your postcode to see offers near you.",
      "Teen mode: 13 to 17 year olds join with a guardian's acceptance.",
    ],
    businesses: [
      "Run a campaign and set a budget.",
      "Reach local viewers by postcode.",
      "See completions and redemptions as they happen.",
      "Offer vouchers that bring people through the door.",
    ],
  },
  {
    id: "snapapp",
    n: 2,
    name: "SnapApp",
    lede: "Snap a receipt. AI reads it and sorts the rest.",
    href: "https://snapapp.gaiada.com",
    host: "snapapp.gaiada.com",
    people: [
      "Photograph a receipt and have the merchant, date, amount and items read for you.",
      "See spending by category and find tax deductions as you go.",
      "Keep a car logbook for work trips.",
      "Send deductions to Free Tax Returns in one step.",
      "Parents can add teens to learn how to track money.",
    ],
    businesses: [
      "A business workspace for receipts and expenses.",
      "Clean records that are ready for the accountant.",
      "Deductions sorted as they are logged, with no end-of-year scramble.",
    ],
  },
  {
    id: "ftr",
    n: 3,
    name: "Free Tax Returns",
    lede: "Free online tax returns for Australians.",
    href: "https://freetaxreturns.com.au",
    host: "freetaxreturns.com.au",
    people: [
      "Lodge a return online at no cost.",
      "Start from your occupation and see the deductions that usually apply to it.",
      "Bring in deductions from SnapApp so nothing is retyped.",
      "Sign in with YourTal if you already have an account.",
    ],
    businesses: [
      "Employers and advisers can point staff and clients to a free lodgement option.",
      "Occupation and deduction patterns feed the group's aggregate insight, never named returns.",
      "Tax file numbers, bank details and the lines of a return stay inside Free Tax Returns.",
    ],
  },
];
---

<Base
  title="Our brands: YourTal, SnapApp and Free Tax Returns | GOD (Global Omni Data)"
  description="Three apps, one family. Each brand has its own site, its own customers and its own job. They share a sign-in and a privacy notice."
>
  <PageHead
    eyebrow="Our brands"
    title="Three apps, one family"
    lede="Each brand has its own site, its own customers and its own job. They share a sign-in and a privacy notice."
  />

  {brands.map((b) => (
    <section class="block bsec" id={b.id}>
      <div class="wrap">
        <div>
          <p class="eyebrow">Brand {b.n}</p>
          <h2>{b.name}</h2>
          <p class="lede">{b.lede}</p>
          <a class="link" href={b.href} target="_blank" rel="noopener">
            {b.host} (opens in a new tab)
          </a>
        </div>
        <div class="twocol">
          <div>
            <h3>For people</h3>
            <ul class="plain">
              {b.people.map((li) => (
                <li>{li}</li>
              ))}
            </ul>
          </div>
          <div>
            <h3>For businesses</h3>
            <ul class="plain">
              {b.businesses.map((li) => (
                <li>{li}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
  ))}
</Base>
