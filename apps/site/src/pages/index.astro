---
import Base from "../layouts/Base.astro";
import AustraliaMap from "../components/AustraliaMap.astro";
import FlowGlyph from "../components/FlowGlyph.astro";
---

<Base
  title="Real-world data for Australian brands | GOD (Global Omni Data)"
  description="Every receipt snapped, campaign watched and tax return started adds to a picture of how Australians live and spend. GOD joins it up across three apps and gives brands the aggregate. Brands never see a person."
>
  <section class="block on-brand hero">
    <div class="wrap">
      <div>
        <h1>Real-world data for Australian brands</h1>
        <p class="lede">
          Every receipt snapped, campaign watched and tax return started adds to a picture of how
          Australians live and spend. We join it up across three apps and give brands the aggregate.
          Brands never see a person.
        </p>
        <div class="row">
          <a class="btn btn-primary" href="/contact/">
            Talk to us about insight
          </a>
          <a class="btn btn-line" href="/brands/">
            Meet the three apps
          </a>
        </div>
      </div>
      <div class="mapbox">
        <AustraliaMap />
        <p class="mapnote">
          Each dot is land, not a person. Density follows where Australians live.
        </p>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="sechead">
        <h2>Three apps people use for different reasons</h2>
        <p class="lede">
          Each one solves a real job. Together they show brands where customers live, what they buy
          and who they are.
        </p>
      </div>
      <div class="brandlist">
        <div class="brandrow">
          <div>
            <h3>YourTal</h3>
            <span class="tag">Watch, earn, redeem</span>
          </div>
          <p>
            People watch short brand campaigns and earn points and vouchers. Businesses run
            campaigns and reach local viewers by postcode. Teens join with a guardian.
          </p>
          <a class="go" href="/brands/#yourtal">
            About YourTal
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
        </div>
        <div class="brandrow">
          <div>
            <h3>SnapApp</h3>
            <span class="tag">Receipts and deductions</span>
          </div>
          <p>
            Snap a receipt and AI reads it, sorts the spending and flags tax deductions. It keeps a
            car logbook and sends deductions on to Free Tax Returns. Parents can add teens.
          </p>
          <a class="go" href="/brands/#snapapp">
            About SnapApp
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
        </div>
        <div class="brandrow">
          <div>
            <h3>Free Tax Returns</h3>
            <span class="tag">freetaxreturns.com.au</span>
          </div>
          <p>
            Free online tax returns for Australians, built around occupations and the deductions
            that go with them.
          </p>
          <a class="go" href="/brands/#ftr">
            About Free Tax Returns
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="sechead">
        <h2>How the three apps connect</h2>
      </div>
      <div class="flow">
        <div>
          <FlowGlyph kind="thread" />
          <h3>One sign-in</h3>
          <p>
            "Sign in with YourTal" works in all three apps. People accept one group privacy notice,
            once, and know where they stand.
          </p>
        </div>
        <div>
          <FlowGlyph kind="merge" />
          <h3>One profile</h3>
          <p>
            What a person does in each app builds a single profile, held by GOD. Using another app
            adds to it. It never counts twice.
          </p>
        </div>
        <div>
          <FlowGlyph kind="grid" />
          <h3>One aggregate</h3>
          <p>
            Brands receive counts by area, age band, occupation and income mix. Any group under 10
            shows as "&lt;10".
          </p>
        </div>
      </div>
    </div>
  </section>

  <!--
    The prototype has a "Reach" band here with three headline figures (people, businesses, postcodes).
    Those figures are not labelled as samples in the prototype and are not verified, so they are left
    out until real, dated numbers are supplied.
  -->

  <section class="block cta">
    <div class="wrap">
      <div class="cta-panel">
        <div>
          <h2>Ask a question about your market and get the aggregate</h2>
          <p class="lede">
            Tell us who you sell to. We reply with what a report would cover, what it would cost and
            how long it takes.
          </p>
        </div>
        <div class="row">
          <a class="btn btn-primary" href="/contact/">
            Start a conversation
          </a>
          <a class="btn btn-line" href="/for-brands/">
            What brands get
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
