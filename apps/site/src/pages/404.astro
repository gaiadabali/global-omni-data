---
import Base from "../layouts/Base.astro";
---

<Base
  title="Page not found | GOD (Global Omni Data)"
  description="That page does not exist. Use the menu to find what you were after."
  noindex
>
  <section class="block on-brand pagehead lost">
    <div class="wrap">
      <p class="eyebrow">Page not found</p>
      <h1>We can't find that page</h1>
      <p class="lede">
        The link may be old, or the address may have a typo. Try the home page, or tell us what you
        were after.
      </p>
      <div class="row">
        <a class="btn btn-primary" href="/">
          Go to the home page
        </a>
        <a class="btn btn-line" href="/contact/">
          Contact us
        </a>
      </div>
    </div>
  </section>
</Base>
