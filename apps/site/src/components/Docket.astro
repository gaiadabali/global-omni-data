---
/**
 * A fictional receipt, drawn in code. The roadhouse does not exist; the sum and GST are correct
 * (38.20 L at $1.989 = $75.98; $87.68 total, GST one eleventh = $7.97). The marked line is the only place
 * GOD's location comes from: the address printed on the receipt, never the phone.
 */
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<div
  class:list={["docket", { compact }]}
  role="img"
  aria-label="A sample fuel docket from a fictional roadhouse in Longreach, Queensland, totalling $87.68"
>
  <div class="paper" aria-hidden="true">
    <p class="shop">Mitchell Rd Roadhouse</p>
    <p class="addr">
      <mark>Longreach QLD 4730</mark>
    </p>
    <p class="c">TAX INVOICE</p>
    <p class="c dim">Thu 27/11/2026 17:42</p>
    <hr />
    <p class="ln">
      <span>Unleaded 91</span>
      <span>75.98</span>
    </p>
    <p class="ln dim">
      <span>&nbsp; 38.20 L @ 1.989</span>
      <span></span>
    </p>
    <p class="ln">
      <span>Flat white</span>
      <span>5.20</span>
    </p>
    <p class="ln">
      <span>Sausage roll</span>
      <span>6.50</span>
    </p>
    <hr />
    <p class="ln tot">
      <span>TOTAL</span>
      <span>$87.68</span>
    </p>
    <p class="ln dim">
      <span>GST included</span>
      <span>7.97</span>
    </p>
    {!compact && <p class="c dim thx">Thanks, drive safe</p>}
  </div>
</div>

<style>
  .docket {
    width: min(100%, 272px);
    margin: 0 auto;
    filter: drop-shadow(0 18px 24px rgb(15 18 48 / 0.18));
  }
  .paper {
    padding: 24px 22px 34px;
    background: #fbfaf6;
    color: #23252f;
    font-family: var(--f-mono);
    font-size: 0.75rem;
    line-height: 1.6;
    -webkit-mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% /
      14px 100%;
    mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% / 14px 100%;
  }
  .compact .paper {
    padding-bottom: 28px;
  }
  .paper p {
    margin: 0;
    color: inherit;
  }
  .shop {
    font-weight: 500;
    font-size: 0.8125rem;
    text-align: center;
    letter-spacing: 0.02em;
  }
  .addr {
    text-align: center;
  }
  mark {
    padding: 1px 4px;
    border-radius: 3px;
    background: #ffe1a8;
    color: inherit;
  }
  .c {
    text-align: center;
  }
  .dim {
    color: #6d707c;
  }
  .ln {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-variant-numeric: tabular-nums;
  }
  .tot {
    font-weight: 500;
    font-size: 0.8125rem;
  }
  .thx {
    margin-top: 12px;
  }
  hr {
    margin: 10px 0;
    border: 0;
    border-top: 1px dashed #b9bac2;
  }
</style>
