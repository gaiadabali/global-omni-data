---
import Icon from "./Icon.astro";

interface Props {
  title?: string;
  lede?: string;
  /** `external` opens the link in a new tab, with a hidden note for screen readers (a brand's own site). */
  primary?: { href: string; label: string; external?: boolean };
  secondary?: { href: string; label: string };
}

const {
  title = "Ask a question about your market",
  lede = "Tell us who you sell to and what you want to know. We reply within two business days with what a report would cover, what it would cost and how long it would take.",
  primary = { href: "/contact/", label: "Start a conversation" },
  secondary = { href: "/for-brands/#sample", label: "See a sample report" },
} = Astro.props;
---

<section class="night cta">
  <div class="wrap">
    <div data-reveal>
      <h2>{title}</h2>
      <p class="lede">{lede}</p>
    </div>
    <div class="row" data-reveal="2">
      <a
        class="btn btn-primary"
        href={primary.href}
        target={primary.external ? "_blank" : undefined}
        rel={primary.external ? "noopener" : undefined}
      >
        {primary.label}
        {primary.external && <span class="visually-hidden"> (opens in a new tab)</span>}
        <Icon name={primary.external ? "external" : "arrow"} />
      </a>
      {secondary && (
        <a class="btn btn-line" href={secondary.href}>
          {secondary.label}
        </a>
      )}
    </div>
  </div>
</section>
