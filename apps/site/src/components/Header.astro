---
import Logo from "./Logo.astro";
import { isCurrent, NAV } from "../lib/site";

const pathname = Astro.url.pathname;
---

<header class="hdr">
  <div class="wrap">
    <a class="brandlink" href="/" aria-label="GOD, Global Omni Data, home">
      <Logo height={38} />
    </a>
    <button
      class="iconbtn menubtn"
      id="menubtn"
      type="button"
      aria-expanded="false"
      aria-controls="nav"
    >
      Menu
    </button>
    <nav class="nav" id="nav" aria-label="Main">
      {NAV.map((item) => (
        <a
          href={item.href}
          class:list={{ navcta: item.href === "/contact/" }}
          aria-current={isCurrent(item.href, pathname) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
      <button class="iconbtn themebtn" id="themebtn" type="button" aria-label="Switch colour theme">
        <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
        <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>
