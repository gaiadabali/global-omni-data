---
import BrandMark from "./BrandMark.astro";
import { brand, type BrandKey } from "../lib/brands";

/**
 * "One mailbox, the same mail everywhere": the Mail screen of SnapApps, YourTal and Free Tax Returns side by side,
 * each in its own brand colour, all showing the same three sample messages. Drawn in HTML and CSS; sample mail only.
 */
const apps: BrandKey[] = ["snapapp", "yourtal", "ftr"];
const mail = [
  { from: "Corner Bakehouse", subject: "Your order is ready", time: "9:41" },
  { from: "Northside Tyres", subject: "Booking confirmed for Thursday", time: "8:15" },
  { from: "City Library", subject: "Your book is due on Friday", time: "Mon" },
];
---

<figure
  class="om"
  role="img"
  aria-label="The Mail screen in SnapApps, YourTal and Free Tax Returns, each in its own colours, all showing the same three sample messages"
>
  <ul class="apps">
    {apps.map((k) => (
      <li data-brand={k}>
        <div class="bar">
          <BrandMark brand={k} name={brand(k).name} />
          <span class="mail">Mail</span>
        </div>
        <ul class="rows">
          {mail.map((m) => (
            <li>
              <span class="from">{m.from}</span>
              <span class="subject">{m.subject}</span>
              <span class="time">{m.time}</span>
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ul>
  <figcaption class="cap">One mailbox, the same sample mail in each app</figcaption>
</figure>

<style>
  .om {
    margin: 0;
  }
  .apps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .apps > li {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--sbui-bg);
    color: var(--sbui-ink);
    box-shadow: var(--shadow-sm);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 12px 14px;
    background: var(--b-stage);
    color: var(--b-on-stage);
  }
  .bar :global(.mark) {
    gap: 8px;
    font-size: 0.875rem;
    color: var(--b-on-stage);
  }
  .bar :global(.mark .tile) {
    width: 28px;
    height: 28px;
    border-radius: 7px;
  }
  .bar :global(.mark .tile img) {
    width: 20px;
  }
  .bar :global(.mark[data-brand="snapapp"] .tile img) {
    width: 28px;
  }
  .mail {
    font-family: var(--f-mono);
    font-size: 0.75rem;
  }
  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rows li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2px 8px;
    padding: 10px 14px;
    border-top: 1px solid var(--sbui-line);
  }
  .from {
    font-size: 0.8125rem;
    font-weight: 560;
  }
  .subject {
    grid-column: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 0.75rem;
    color: var(--sbui-muted);
  }
  .time {
    grid-row: 1;
    grid-column: 2;
    font-family: var(--f-mono);
    font-size: 0.625rem;
    color: var(--sbui-muted);
  }
  @media (max-width: 720px) {
    .apps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
