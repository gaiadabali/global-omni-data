---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { BRANDS } from "../lib/brands";
import { CONTACT_EMAIL } from "../lib/site";
---

<footer class="ftr">
  <div class="wrap">
    <div class="cols">
      <div>
        <Logo height={48} />
        <p>
          The Australian group behind YourTal, SnapApp and Free Tax Returns. We turn what people do,
          with their consent, into insight for brands. Brands never see a person.
        </p>
      </div>
      <div>
        <h2>Our brands</h2>
        <ul class="brandlist">
          {BRANDS.map((b) => (
            <li>
              <a href={b.page}>{b.name}</a>
              <a class="ext" href={b.href} target="_blank" rel="noopener">
                <span class="visually-hidden">Visit </span>
                {b.host}
                <span class="visually-hidden"> (opens {b.name}'s own site in a new tab)</span>
                <Icon name="external" />
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2>GOD</h2>
        <ul>
          <li>
            <a href="/for-brands/">For brands</a>
          </li>
          <li>
            <a href="/how-it-works/">How it works</a>
          </li>
          <li>
            <a href="/about/">About</a>
          </li>
          <li>
            <a href="/contact/">Contact</a>
          </li>
        </ul>
      </div>
      <div>
        <h2>Trust</h2>
        <ul>
          <li>
            <a href="/privacy/">Trust &amp; privacy</a>
          </li>
          <li>
            <a href="/privacy/#teens">The teen standard</a>
          </li>
          <li>
            <a href="/privacy-notice/">Group Privacy Notice</a>
          </li>
          <li>
            <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="legal">
      <span>&copy; 2026 Global Omni Data</span>
      <a href="https://dashboard.god.gaiada.com">Staff sign-in</a>
    </div>
  </div>
</footer>
