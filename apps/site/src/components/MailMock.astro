---
/**
 * The Spambank Mail screen as an illustration: a phone showing sample mail, drawn in HTML and CSS (no screenshot,
 * no real messages, made-up senders). Two views: the inbox, and the Junk folder with one-tap unsubscribe.
 * The screen is the app's own light screen, so it keeps the same colours in light and dark mode
 * (`--sbui-*` tokens in styles/brands.css).
 */
interface Props {
  view?: "inbox" | "junk";
  caption?: string;
}

const { view = "inbox", caption = "Sample mail, not real messages" } = Astro.props;

const inbox = [
  {
    from: "Corner Bakehouse",
    subject: "Your order is ready",
    preview: "Pick it up at the front counter until 5pm.",
    time: "9:41",
    unread: true,
  },
  {
    from: "Northside Tyres",
    subject: "Booking confirmed for Thursday",
    preview: "We have you down for 10:00. Bring the key.",
    time: "8:15",
    unread: true,
  },
  {
    from: "City Library",
    subject: "Your book is due on Friday",
    preview: "Renew it online or at the desk.",
    time: "Mon",
    unread: false,
  },
  {
    from: "Hollis Dental",
    subject: "Appointment reminder",
    preview: "See you next Tuesday at 2:30pm.",
    time: "Sun",
    unread: false,
  },
];
const junk = [
  { from: "Megamart Deals", subject: "Weekend sale: everything must go", tag: "Newsletter" },
  { from: "Gadget Planet", subject: "You have been selected", tag: "Bulk mail" },
  { from: "Travel Daily", subject: "Ten islands you will love", tag: "Newsletter" },
  { from: "Shoe Barn", subject: "Last chance: 40% off boots", tag: "Bulk mail" },
];
const tabs = ["Inbox", "Junk", "Sent", "Trash"];
const active = view === "junk" ? "Junk" : "Inbox";
const label =
  view === "junk"
    ? "The Spambank Junk folder on a phone: four sample bulk messages, each with an Unsubscribe button."
    : "The Spambank inbox on a phone: four sample messages, two unread, under the address quickloris@yourtal.gaiada.com.";
---

<figure class="device mm">
  <div class="phone" role="img" aria-label={label}>
    <div class="screen">
      <div class="head">
        <span class="title">{active}</span>
        {view === "inbox" ? (
          <span class="addr">quickloris@yourtal.gaiada.com</span>
        ) : (
          <span class="addr">Bulk mail lands here on its own</span>
        )}
      </div>
      <div class="search">Search mail</div>
      {view === "inbox" ? (
        <ul class="rows">
          {inbox.map((m) => (
            <li class:list={{ unread: m.unread }}>
              <span class="dot" />
              <span class="main">
                <span class="from">{m.from}</span>
                <span class="subject">{m.subject}</span>
                <span class="preview">{m.preview}</span>
              </span>
              <span class="time">{m.time}</span>
            </li>
          ))}
        </ul>
      ) : (
        <ul class="rows junk">
          {junk.map((m) => (
            <li>
              <span class="main">
                <span class="from">{m.from}</span>
                <span class="subject">{m.subject}</span>
                <span class="tag">{m.tag}</span>
              </span>
              <span class="unsub">Unsubscribe</span>
            </li>
          ))}
        </ul>
      )}
      <div class="tabs">
        {tabs.map((t) => (
          <span class:list={{ on: t === active }}>{t}</span>
        ))}
      </div>
    </div>
  </div>
  {caption && <figcaption class="cap">{caption}</figcaption>}
</figure>

<style>
  .screen {
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr) auto;
    aspect-ratio: 390 / 690;
    overflow: hidden;
    border-radius: 22px;
    background: var(--sbui-bg);
    color: var(--sbui-ink);
    font-family: var(--f-text);
    line-height: 1.3;
  }
  .head {
    display: grid;
    gap: 2px;
    padding: 16px 14px 8px;
  }
  .title {
    font-size: 1.375rem;
    font-weight: 650;
    letter-spacing: -0.01em;
  }
  .addr {
    font-family: var(--f-mono);
    font-size: 0.6875rem;
    color: var(--sbui-accent);
  }
  .search {
    margin: 0 14px 8px;
    padding: 8px 12px;
    border-radius: 10px;
    background: var(--sbui-wash);
    font-size: 0.75rem;
    color: var(--sbui-muted);
  }
  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
    overflow: hidden;
  }
  .rows li {
    display: grid;
    grid-template-columns: 8px minmax(0, 1fr) auto;
    gap: 10px;
    align-items: start;
    padding: 10px 14px;
    border-top: 1px solid var(--sbui-line);
  }
  .rows.junk li {
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
  }
  .dot {
    width: 8px;
    height: 8px;
    margin-top: 5px;
    border-radius: 50%;
  }
  .unread .dot {
    background: var(--sbui-accent);
  }
  .main {
    display: grid;
    gap: 1px;
    min-width: 0;
  }
  .from {
    font-size: 0.8125rem;
    font-weight: 560;
  }
  .subject {
    font-size: 0.75rem;
    color: var(--sbui-ink);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .unread .subject {
    font-weight: 600;
  }
  .preview,
  .tag {
    font-size: 0.6875rem;
    color: var(--sbui-muted);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .time {
    font-family: var(--f-mono);
    font-size: 0.625rem;
    color: var(--sbui-muted);
  }
  .unsub {
    padding: 5px 10px;
    border-radius: 999px;
    background: var(--sbui-accent-soft);
    font-size: 0.6875rem;
    font-weight: 600;
    color: #0a4a5a;
    white-space: nowrap;
  }
  .tabs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    padding: 8px 6px 10px;
    border-top: 1px solid var(--sbui-line);
    background: var(--sbui-wash);
    text-align: center;
    font-size: 0.6875rem;
    color: var(--sbui-muted);
  }
  .tabs .on {
    font-weight: 650;
    color: var(--sbui-accent);
  }
</style>
