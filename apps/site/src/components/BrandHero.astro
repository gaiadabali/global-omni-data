---
import BrandLockup from "./BrandLockup.astro";
import Icon from "./Icon.astro";
import { brand, type BrandKey } from "../lib/brands";

/**
 * The head of a brand page: breadcrumbs, the brand's logo on its own ground, the h1, a lede, its honest status, a
 * button to the brand's own site and one to GOD's contact page. A device frame goes in the "visual" slot, on the
 * brand's stage plate. The page's `<main>` carries `data-brand`, so the accent colour is already in scope here
 * (tokens in `styles/brands.css`).
 */
interface Props {
  brand: BrandKey;
  title: string;
  lede: string;
  secondary?: { href: string; label: string };
}

const {
  brand: key,
  title,
  lede,
  secondary = { href: "/contact/", label: "Talk to GOD" },
} = Astro.props;
const b = brand(key);
---

<section class="phero bhero">
  <div class="wrap">
    <div>
      <nav aria-label="Breadcrumb">
        <ol class="crumbs">
          <li>
            <a href="/">Home</a>
          </li>
          <li>
            <a href="/brands/">Our brands</a>
          </li>
          <li>
            <span aria-current="page">{b.name}</span>
          </li>
        </ol>
      </nav>
      <div class="bh-id">
        <BrandLockup brand={key} name={b.name} size="lg" eager />
      </div>
      <h1>{title}</h1>
      <p class="lede">{lede}</p>
      <p class="bh-status">
        <span class={`status ${b.status.kind}`}>{b.status.label}</span>
      </p>
      <div class="row">
        <a class="btn btn-primary" href={b.href} target="_blank" rel="noopener">
          Visit {b.host}
          <span class="visually-hidden"> (opens {b.name}'s own site in a new tab)</span>
          <Icon name="external" />
        </a>
        <a class="btn btn-line" href={secondary.href}>
          {secondary.label}
        </a>
      </div>
      {b.webApp && (
        <p class="ext-note">
          The web app:{" "}
          <a href={b.webApp.href} target="_blank" rel="noopener">
            {b.webApp.host}
            <span class="visually-hidden"> (opens the {b.name} web app in a new tab)</span>
            <Icon name="external" />
          </a>
        </p>
      )}
    </div>
    <div class="phero-visual stage">
      <slot name="visual" />
    </div>
  </div>
</section>

<style>
  .bh-id {
    margin-bottom: 28px;
  }
  .bh-status {
    margin: 20px 0 0;
  }
</style>
