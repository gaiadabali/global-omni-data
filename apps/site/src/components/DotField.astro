---
/**
 * The aggregate, drawn: each dot is a group of people counted together, never a person. One hollow ring is a
 * group too small to show, which a brand sees as "<10". Deterministic, built at build time.
 */
interface Props {
  cols?: number;
  rows?: number;
  label?: string;
}
const { cols = 12, rows = 8, label = "A grid of dots, each a counted group, with one hollow ring for a group under ten" } = Astro.props;
const rnd = (i: number) => {
  const s = Math.sin(i * 91.7 + 13.1) * 43758.5453;
  return s - Math.floor(s);
};
const cells = Array.from({ length: cols * rows }, (_, i) => {
  const x = i % cols;
  const y = Math.floor(i / cols);
  // Denser towards the lower right, like a catchment around one shop.
  const d = Math.hypot(x - cols * 0.68, y - rows * 0.62) / Math.hypot(cols, rows);
  const v = Math.max(0, 1 - d * 1.9) + rnd(i) * 0.25;
  return { cx: 8 + x * 16, cy: 8 + y * 16, r: 1.6 + v * 3.4, hot: v > 0.78 };
});
const ringAt = Math.floor(cols * 1.5 + 2);
---

<svg class="dotfield" viewBox={`0 0 ${cols * 16} ${rows * 16}`} role="img" aria-label={label}>
  {
    cells.map((c, i) =>
      i === ringAt ? (
        <circle class="ring" cx={c.cx} cy={c.cy} r="4" />
      ) : (
        <circle class:list={[c.hot ? "hot" : "dot"]} cx={c.cx} cy={c.cy} r={c.r.toFixed(2)} />
      ),
    )
  }
</svg>

<style>
  .dotfield {
    width: 100%;
    height: auto;
  }
  .dot {
    fill: var(--dot-dim);
  }
  .hot {
    fill: var(--indigo-ink);
  }
  .ring {
    fill: none;
    stroke: var(--ring);
    stroke-width: 1.4;
  }
</style>
