---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "./Icon.astro";

/** A real desktop page in a CSS-drawn browser window, with the page's own address in the bar. */
interface Props {
  src: ImageMetadata;
  alt: string;
  url: string;
  caption?: string;
  eager?: boolean;
}

const { src, alt, url, caption, eager = false } = Astro.props;
---

<figure class="device">
  <div class="browser">
    <div class="bar" aria-hidden="true">
      <span class="url">
        <Icon name="lock" />
        {url}
      </span>
    </div>
    <Picture
      src={src}
      alt={alt}
      widths={[640, 768, 960, 1280, 1920].filter((x) => x <= src.width)}
      sizes="(max-width: 960px) calc(100vw - 32px), 680px"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : undefined}
      decoding="async"
    />
  </div>
  {caption && <figcaption class="cap">{caption}</figcaption>}
</figure>
